{% extends "base.html.j2" %}
{% block title %}{{ meta.name }} · Geopol{% endblock %}
{% block content %}
<section class="panel trend-{{ meta.trend }} story-head">
  <div class="col-label">STORYLINE</div>
  <h1 class="page-title">{{ meta.name }}</h1>
  <div class="sp-spark big">{{ meta.spark }}</div>
  <div class="sp-trend">{{ trend_labels[meta.trend] }}</div>
  {% if meta.has_background %}<p><a href="{{ base }}background/{{ meta.slug }}.html">Background: how we got here →</a></p>{% endif %}
</section>

{% if takes %}
<section class="panel">
  <div class="col-label">CALLS MADE ON THIS STORYLINE</div>
  {% for t in takes %}
  <div class="box take">
    <span class="box-label"><a href="{{ base }}b/{{ t.run_id }}.html">{{ run_label(t.run_id) }}</a> · {{ t.take.confidence | upper }} CONFIDENCE</span>
    <p>{{ t.take.text }}</p>
    <p class="why"><strong>Wrong if:</strong> {{ t.take.wrong_if }}</p>
    {% for run_id, r in t.reviews %}
    <p class="verdict-{{ r.verdict }}"><strong>{{ r.verdict | upper }}</strong> ({{ run_label(run_id) }}): {{ r.text }}</p>
    {% endfor %}
  </div>
  {% endfor %}
</section>
{% endif %}

<section class="panel">
  <div class="col-label">EVERY UPDATE, NEWEST FIRST</div>
  {% if not entries %}<p class="muted">Nothing written on this storyline yet.</p>{% endif %}
  <ul class="list">
    {% for e in entries %}
    <li><a href="{{ base }}b/{{ e.run_id }}.html"><span class="muted">{{ run_label(e.run_id) }}</span> {{ e.item.headline }}</a>
      <p class="muted small">{{ e.item.so_what }}</p></li>
    {% endfor %}
  </ul>
</section>
{% endblock %}
